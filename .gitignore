# =============================================================================
#  Wrapper repo: holds only the launchers (win/, linux/) and the docs.
#  The three app repos are INDEPENDENT (each its own .git) and are NOT part of
#  this repo.
# =============================================================================

# --- App repos (each is its own git repository) ------------------------------
AI-VL-core/
AI-VL-backend/
AI-VL-frontend/

# --- Local TLS certificates --------------------------------------------------
# Generated per machine/IP by the run launcher (linux/run.sh, win/run.ps1). The
# private key (key.pem) must NEVER be pushed to git; they also depend on the IP,
# so versioning them is pointless.
certs/

# --- Runtime logs ------------------------------------------------------------
# Service stdout/stderr captured while running (leak LAN IPs, bloat the repo).
*.log

# --- codebase-memory reindex cache (per-machine signatures) ------------------
.claude/.reindex-state/

# --- OS / editor cruft -------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.vscode/
.idea/
